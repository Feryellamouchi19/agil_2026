<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="850.0" spacing="20.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.userapp.controller.AdminController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <!-- Controls Row -->
      <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="glass-card">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <TextField fx:id="searchField" prefHeight="40.0" prefWidth="300.0" promptText="Rechercher par nom ou email..." />
            <ComboBox fx:id="roleFilterCombo" prefHeight="40.0" prefWidth="150.0" promptText="Rôle" />
            
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="createBtn" mnemonicParsing="false" onAction="#handleCreateAccount" prefHeight="40.0" prefWidth="180.0" styleClass="button-primary" text="Nouveau compte" />
               </children>
            </HBox>
         </children>
      </HBox>
      
      <!-- Cards Container -->
      <VBox styleClass="glass-card" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
               <content>
                  <FlowPane fx:id="cardsContainer" hgap="20.0" vgap="20.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</VBox>
