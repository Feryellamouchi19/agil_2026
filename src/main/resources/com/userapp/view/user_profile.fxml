<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox prefHeight="700.0" prefWidth="850.0" spacing="20.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.userapp.controller.UserProfileController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>

      <!-- Photo Upload Card -->
      <VBox alignment="CENTER" spacing="15.0" styleClass="glass-card">
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
         <children>
            <Label text="Photo de Profil" styleClass="text-subtitle" />

            <!-- Circular Avatar with Photo -->
            <StackPane alignment="CENTER" prefHeight="120.0" prefWidth="120.0">
               <children>
                  <!-- Circle background / clip area -->
                  <Circle fx:id="avatarCircle" radius="55.0" fill="#f1f5f9" stroke="#e2e8f0" strokeWidth="2.0" />
                  <!-- Initials fallback label -->
                  <Label fx:id="avatarInitialsLabel" text="?" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #e11d48;" />
                  <!-- Photo image (shown when photo is available) -->
                  <ImageView fx:id="profilePhotoView" fitHeight="110.0" fitWidth="110.0" preserveRatio="false" smooth="true" visible="false">
                     <clip>
                        <Circle radius="55.0" centerX="55.0" centerY="55.0" />
                     </clip>
                  </ImageView>
               </children>
            </StackPane>

            <!-- Upload / Remove buttons -->
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="uploadPhotoBtn" mnemonicParsing="false" onAction="#handleUploadPhoto" prefHeight="38.0" text="📷  Changer la photo">
                     <styleClass>
                        <String fx:value="button-secondary" />
                     </styleClass>
                  </Button>
                  <Button fx:id="removePhotoBtn" mnemonicParsing="false" onAction="#handleRemovePhoto" prefHeight="38.0" text="Supprimer" visible="false" managed="false">
                     <styleClass>
                        <String fx:value="button-danger" />
                     </styleClass>
                  </Button>
               </children>
            </HBox>
            <Label text="Formats acceptés : JPG, PNG • Taille max : 5 Mo" styleClass="text-muted" />
         </children>
      </VBox>

      <!-- Info Cards Row -->
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Personal Info Card -->
            <VBox spacing="15.0" styleClass="glass-card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Informations Personnelles" styleClass="text-subtitle" />

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Nom complet :" styleClass="text-header" />
                        <TextField fx:id="nameField" prefHeight="40.0" promptText="Nom complet" />
                     </children>
                  </VBox>

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Adresse E-mail :" styleClass="text-header" />
                        <TextField fx:id="emailField" editable="false" disable="true" prefHeight="40.0" style="-fx-opacity: 0.6;" />
                     </children>
                  </VBox>

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Téléphone :" styleClass="text-header" />
                        <TextField fx:id="telField" prefHeight="40.0" promptText="Numéro de téléphone" />
                     </children>
                  </VBox>

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Rôle :" styleClass="text-header" />
                        <TextField fx:id="roleField" editable="false" disable="true" prefHeight="40.0" style="-fx-opacity: 0.6;" />
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- Security Card -->
            <VBox spacing="15.0" styleClass="glass-card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Sécurité &amp; Mot de Passe" styleClass="text-subtitle" />

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Mot de passe actuel :" styleClass="text-header" />
                        <PasswordField fx:id="oldPassField" prefHeight="40.0" promptText="Laisser vide pour ne pas modifier" />
                     </children>
                  </VBox>

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Nouveau mot de passe :" styleClass="text-header" />
                        <PasswordField fx:id="newPassField" prefHeight="40.0" promptText="Nouveau mot de passe" />
                     </children>
                  </VBox>

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Confirmer le mot de passe :" styleClass="text-header" />
                        <PasswordField fx:id="confirmPassField" prefHeight="40.0" promptText="Confirmer" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Save Button Row -->
      <HBox alignment="CENTER" prefHeight="60.0">
         <children>
            <Button fx:id="saveBtn" mnemonicParsing="false" onAction="#handleSave" prefHeight="45.0" prefWidth="300.0" text="Enregistrer les modifications">
               <styleClass>
                  <String fx:value="button-primary" />
               </styleClass>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
