<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="850.0" spacing="15.0" style="-fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.userapp.controller.JournalController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>

      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="📋  Journal d'Activité" styleClass="text-title"
                   style="-fx-text-fill: #1e293b; -fx-font-size: 22px;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="totalLabel" text="0 entrée(s)" styleClass="text-muted" />
            <Button fx:id="refreshBtn" text="🔄  Actualiser" onAction="#handleRefresh"
                    styleClass="button-secondary" prefHeight="36.0" />
         </children>
      </HBox>

      <!-- Search + Filter Bar -->
      <HBox spacing="15.0" styleClass="glass-card">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <TextField fx:id="searchField" prefHeight="40.0" prefWidth="350.0"
                       promptText="Rechercher par utilisateur ou action..."
                       onKeyReleased="#handleSearch"/>
            <ComboBox fx:id="filterCombo" prefHeight="40.0" prefWidth="200.0"
                      onAction="#handleFilter" />
         </children>
      </HBox>

      <!-- Log Cards List -->
      <VBox styleClass="glass-card" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="logContainer" spacing="10.0">
                     <padding>
                        <Insets bottom="5.0" right="5.0" top="5.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>

   </children>
</VBox>
