{% extends 'base.html.twig' %}

{% block title %}Mon Ticket {{ ticket.numeroTicket }} - AGIL Queue{% endblock %}

{% block stylesheets %}
<meta http-equiv="refresh" content="15">
{% endblock %}

{% block body %}
<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="text-center mb-3">
            <span class="badge bg-info text-dark p-2"><i class="bi bi-arrow-repeat me-1"></i>Actualisation automatique toutes les 15 sec</span>
        </div>

        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- En-tête AGIL Ticket -->
            <div class="bg-primary text-white text-center p-4">
                <h3 class="fw-bold mb-0 text-warning"><i class="bi bi-droplet-fill"></i> AGIL</h3>
                <p class="small mb-0 opacity-75">Société Nationale de Distribution des Pétroles</p>
                <div class="mt-3">
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">{{ ticket.service.nomService }}</span>
                </div>
            </div>

            <!-- Corps Ticket -->
            <div class="card-body text-center p-4 bg-light">
                <h6 class="text-uppercase text-muted fw-bold">Numéro de Ticket</h6>
                <div class="display-1 fw-extrabold text-primary my-2" style="letter-spacing: 2px;">
                    {{ ticket.numeroTicket }}
                </div>

                <!-- Badge du Statut -->
                <div class="my-3">
                    {% if ticket.statut == 'En attente' %}
                        <span class="badge bg-warning text-dark px-4 py-2 fs-6 rounded-pill"><i class="bi bi-hourglass-split me-1"></i>En attente</span>
                    {% elseif ticket.statut == 'Appelé' %}
                        <span class="badge bg-danger px-4 py-2 fs-6 rounded-pill animate-pulse">
                            <i class="bi bi-megaphone-fill me-1"></i>
                            C'est votre tour !
                            {% if ticket.guichet %}
                                — Rendez-vous au guichet N° <strong>{{ ticket.guichet.numero }}</strong>
                            {% endif %}
                        </span>
                    {% elseif ticket.statut == 'En cours' %}
                        <span class="badge bg-info text-dark px-4 py-2 fs-6 rounded-pill"><i class="bi bi-gear-fill me-1"></i>En cours de traitement</span>
                    {% elseif ticket.statut == 'Terminé' %}
                        <span class="badge bg-success px-4 py-2 fs-6 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Terminé</span>
                    {% else %}
                        <span class="badge bg-secondary px-4 py-2 fs-6 rounded-pill">{{ ticket.statut }}</span>
                    {% endif %}
                </div>

                <hr class="my-4">

                <!-- Infos File d'attente -->
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-3 shadow-sm">
                            <i class="bi bi-people-fill display-6 text-primary mb-1"></i>
                            <div class="fs-4 fw-bold">
                                {% if ticket.statut == 'En attente' %}
                                    {{ position }}
                                {% else %}
                                    <i class="bi bi-check-lg text-success"></i>
                                {% endif %}
                            </div>
                            <div class="small text-muted">
                                {% if ticket.statut == 'En attente' %}
                                    Position dans la file
                                {% else %}
                                    Traitement en cours
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-3 shadow-sm">
                            <i class="bi bi-clock-history display-6 text-warning mb-1"></i>
                            <div class="fs-4 fw-bold">~{{ ticket.tempsEstime }} min</div>
                            <div class="small text-muted">Temps estimé</div>
                        </div>
                    </div>
                </div>

                <!-- QR Code -->
                {% if ticket.qrCode %}
                <div class="mt-4 p-3 bg-white rounded-3 shadow-sm d-inline-block">
                    <img src="{{ ticket.qrCode }}" alt="QR Code Ticket" class="img-fluid" style="max-width: 180px;">
                    <p class="small text-muted mt-2 mb-0">Scannez pour suivre votre ticket sur mobile</p>
                </div>
                {% endif %}

                <p class="fst-italic text-muted mt-4 mb-0">"Merci pour votre visite chez AGIL."</p>
            </div>

            <!-- Pied de ticket & Actions -->
            <div class="card-footer bg-white p-3 text-center d-flex justify-content-center gap-2">
                <a href="{{ path('app_client_ticket_pdf', {id: ticket.id}) }}" target="_blank" class="btn btn-danger rounded-pill px-4">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Télécharger PDF
                </a>
                <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-printer-fill me-1"></i> Imprimer
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
