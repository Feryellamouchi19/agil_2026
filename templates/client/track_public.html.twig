{% extends 'base.html.twig' %}

{% block title %}Suivi Ticket {{ ticket.numeroTicket }} - AGIL{% endblock %}

{% block stylesheets %}
<meta http-equiv="refresh" content="10">
{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="text-center mb-3">
            <span class="badge bg-secondary p-2"><i class="bi bi-arrow-repeat me-1"></i>Actualisation automatique (10s)</span>
        </div>

        <div class="card shadow-lg border-0 rounded-4 overflow-hidden text-center">
            <div class="bg-primary text-white p-4">
                <h3 class="fw-bold text-warning"><i class="bi bi-droplet-fill"></i> AGIL</h3>
                <p class="small mb-0">Suivi en direct de votre position</p>
            </div>
            <div class="card-body p-4 bg-light">
                <h5 class="text-muted">{{ ticket.service.nomService }}</h5>
                <div class="display-2 fw-bold text-primary my-2">{{ ticket.numeroTicket }}</div>

                <div class="my-3">
                    {% if ticket.statut == 'En attente' %}
                        <span class="badge bg-warning text-dark px-4 py-2 fs-6 rounded-pill">
                            <i class="bi bi-hourglass-split me-1"></i>En attente
                        </span>
                    {% elseif ticket.statut == 'Appelé' %}
                        <span class="badge bg-danger px-4 py-2 fs-5 rounded-pill animate-bounce">
                            <i class="bi bi-megaphone-fill me-1"></i> C'est votre tour !<br>
                            {% if ticket.guichet %}
                                Rendez-vous au guichet N° <strong>{{ ticket.guichet.numero }}</strong>
                            {% endif %}
                        </span>
                    {% elseif ticket.statut == 'En cours' %}
                        <span class="badge bg-info text-dark px-4 py-2 fs-6 rounded-pill">
                            <i class="bi bi-gear-fill me-1"></i>En cours au guichet {{ ticket.guichet ? ticket.guichet.numero : '' }}
                        </span>
                    {% elseif ticket.statut == 'Terminé' %}
                        <span class="badge bg-success px-4 py-2 fs-6 rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i>Terminé
                        </span>
                    {% else %}
                        <span class="badge bg-secondary px-4 py-2 fs-6 rounded-pill">{{ ticket.statut }}</span>
                    {% endif %}
                </div>

                <div class="row mt-4 g-3">
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-3 shadow-sm">
                            <div class="display-6 fw-bold text-primary">
                                {% if ticket.statut == 'En attente' %}
                                    {{ position }}
                                {% else %}
                                    <i class="bi bi-check-lg text-success"></i>
                                {% endif %}
                            </div>
                            <div class="small text-muted">
                                {% if ticket.statut == 'En attente' %}
                                    Position dans la file
                                {% else %}
                                    Pris en charge
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-3 shadow-sm">
                            <div class="display-6 fw-bold text-warning">~{{ ticket.tempsEstime }} min</div>
                            <div class="small text-muted">Temps restant</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
