{% extends 'base.html.twig' %}

{% block title %}Ma Fidélité – AGIL{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --gold: #f59e0b;
        --gold-light: #fde68a;
        --gold-dark: #b45309;
        --brand: #1d4ed8;
    }

    .fidelite-hero {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 60%, #0f172a 100%);
        border-radius: 1.5rem;
        padding: 2.5rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .fidelite-hero::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 220px; height: 220px;
        background: radial-gradient(circle, rgba(245,158,11,.25) 0%, transparent 70%);
        border-radius: 50%;
    }
    .points-badge {
        font-size: 3.5rem;
        font-weight: 800;
        color: var(--gold);
        line-height: 1;
        text-shadow: 0 0 20px rgba(245,158,11,.5);
    }
    .progress-track {
        background: rgba(255,255,255,0.15);
        border-radius: 50px;
        height: 14px;
        overflow: hidden;
        margin-top: .5rem;
    }
    .progress-fill {
        height: 100%;
        border-radius: 50px;
        background: linear-gradient(90deg, var(--gold) 0%, #fbbf24 100%);
        box-shadow: 0 0 12px rgba(245,158,11,.6);
        transition: width 1.2s cubic-bezier(.4,0,.2,1);
    }

    .voucher-card {
        border: 2px dashed var(--gold);
        border-radius: 1rem;
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        position: relative;
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
    }
    .voucher-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.1); }
    .voucher-card .stamp {
        position: absolute; top: 12px; right: 12px;
        background: var(--gold);
        color: #fff;
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 50px;
        letter-spacing: .05em;
    }
    .voucher-value { font-size: 2.2rem; font-weight: 800; color: var(--gold-dark); }

    .tx-row { border-left: 3px solid transparent; transition: background .15s; }
    .tx-row:hover { background: #f8fafc; }
    .tx-row.gain { border-color: #22c55e; }
    .tx-row.reward { border-color: var(--gold); }

    .stat-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 50px;
        padding: .35rem .9rem;
        font-size: .85rem;
    }
</style>
{% endblock %}

{% block body %}

{# ─── Flash messages ─── #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

{# ─── Hero card ─── #}
<div class="fidelite-hero mb-4 shadow">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <div class="small text-white-50 mb-1 text-uppercase fw-bold letter-spacing">Programme de Fidélité</div>
            <h1 class="h3 fw-bold mb-2 text-white">Bonjour, {{ user.prenom }} 👋</h1>

            <div class="d-flex align-items-end gap-2 mb-3">
                <span class="points-badge">{{ user.points }}</span>
                <span class="text-white-50 mb-1">/ 1 000 points</span>
            </div>

            <div class="progress-track" style="max-width:340px">
                <div class="progress-fill" style="width: {{ progress }}%"></div>
            </div>
            <div class="text-white-50 small mt-1">
                {% if user.points >= 1000 %}
                    🎉 Vous avez un bon disponible !
                {% else %}
                    {{ 1000 - user.points }} points restants pour votre prochain bon de 50 DT
                {% endif %}
            </div>
        </div>

        <div class="d-flex flex-column gap-2 mt-2">
            <div class="stat-chip text-white">
                <i class="bi bi-gift-fill text-warning"></i>
                <span>{{ activeVouchers|length }} bon{{ activeVouchers|length > 1 ? 's' : '' }} actif{{ activeVouchers|length > 1 ? 's' : '' }}</span>
            </div>
            <div class="stat-chip text-white">
                <i class="bi bi-clock-history text-warning"></i>
                <span>{{ transactions|length }} transaction{{ transactions|length > 1 ? 's' : '' }}</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    {# ─── Active vouchers ─── #}
    <div class="col-lg-5">
        <h5 class="fw-bold mb-3"><i class="bi bi-gift-fill text-warning me-2"></i>Mes Bons Actifs</h5>

        {% if activeVouchers is empty %}
            <div class="card border-0 rounded-3 text-center py-5 bg-white shadow-sm">
                <i class="bi bi-gift fs-1 text-muted mb-2"></i>
                <div class="text-muted small">Aucun bon disponible pour l'instant.</div>
                <div class="text-muted small mt-1">Continuez à accumuler des points !</div>
            </div>
        {% else %}
            {% for voucher in activeVouchers %}
            <div class="voucher-card p-3 mb-3 shadow-sm">
                <span class="stamp">Actif</span>
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-cash-coin fs-2 text-warning"></i>
                    <div>
                        <div class="voucher-value">{{ voucher.value|number_format(0) }} DT</div>
                        <div class="text-muted small">Généré le {{ voucher.createdAt|date('d/m/Y') }}</div>
                    </div>
                </div>
                <a href="{{ path('app_fidelite_use_voucher', {id: voucher.id}) }}"
                   class="btn btn-warning btn-sm rounded-pill mt-3 fw-semibold"
                   onclick="return confirm('Confirmer l\'utilisation de ce bon de {{ voucher.value|number_format(0) }} DT ?')">
                    <i class="bi bi-check2-circle me-1"></i> Utiliser ce bon
                </a>
            </div>
            {% endfor %}
        {% endif %}

        {# Used/expired vouchers #}
        {% set usedVouchers = vouchers|filter(v => not v.active) %}
        {% if usedVouchers|length > 0 %}
            <h6 class="text-muted fw-semibold mt-4 mb-2">Bons utilisés / expirés</h6>
            {% for voucher in usedVouchers %}
            <div class="card border-0 rounded-3 mb-2 shadow-sm opacity-50">
                <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-muted">{{ voucher.value|number_format(0) }} DT</span>
                        <span class="badge bg-secondary ms-2">{{ voucher.status == 'used' ? 'Utilisé' : 'Expiré' }}</span>
                    </div>
                    <small class="text-muted">{{ voucher.createdAt|date('d/m/Y') }}</small>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>

    {# ─── Transaction history ─── #}
    <div class="col-lg-7">
        <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-brand me-2" style="color:var(--brand)"></i>Historique des Points</h5>

        {% if transactions is empty %}
            <div class="card border-0 rounded-3 text-center py-5 bg-white shadow-sm">
                <i class="bi bi-list-ul fs-1 text-muted mb-2"></i>
                <div class="text-muted small">Aucune transaction pour le moment.</div>
            </div>
        {% else %}
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Type</th>
                            <th>Détail</th>
                            <th class="text-end pe-3">Points</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for tx in transactions %}
                        <tr class="tx-row {{ tx.type }}">
                            <td class="ps-3 text-muted small align-middle">
                                {{ tx.createdAt|date('d/m/Y H:i') }}
                            </td>
                            <td class="align-middle">
                                {% if tx.type == 'gain' %}
                                    <span class="badge rounded-pill" style="background:#dcfce7;color:#166534">
                                        <i class="bi bi-plus-circle-fill me-1"></i>Gain
                                    </span>
                                {% else %}
                                    <span class="badge rounded-pill" style="background:#fef3c7;color:#92400e">
                                        <i class="bi bi-gift-fill me-1"></i>Récompense
                                    </span>
                                {% endif %}
                            </td>
                            <td class="align-middle small text-muted">
                                {% if tx.type == 'gain' %}
                                    Bon valeur : {{ tx.value|number_format(2) }} DT
                                {% else %}
                                    Bon de {{ tx.value|number_format(0) }} DT généré
                                {% endif %}
                            </td>
                            <td class="text-end pe-3 align-middle fw-bold">
                                {% if tx.type == 'gain' %}
                                    <span class="text-success">+{{ tx.value|number_format(0) }}</span>
                                {% else %}
                                    <span class="text-warning">−1000</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {# How it works #}
        <div class="card border-0 rounded-3 shadow-sm mt-4 p-3" style="background:linear-gradient(135deg,#eff6ff,#dbeafe)">
            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-info-circle me-2"></i>Comment ça marche ?</h6>
            <ul class="mb-0 small text-secondary ps-3">
                <li>Chaque <strong>1 DT</strong> de bon valeur traité = <strong>1 point</strong></li>
                <li>Atteignez <strong>1 000 points</strong> pour gagner un <strong>bon de 50 DT</strong></li>
                <li>Les points restants sont conservés après chaque récompense</li>
                <li>Vos bons sont générés automatiquement à chaque palier</li>
            </ul>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
