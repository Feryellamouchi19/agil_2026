{% extends 'base.html.twig' %}

{% block title %}Connexion - AGIL Queue{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-5">
                <form method="post">
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <h3 class="card-title text-center fw-bold text-primary mb-4">Connexion</h3>

                    <div class="mb-3">
                        <label for="inputEmail" class="form-label">Adresse Email</label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                    </div>

                    <div class="mb-4">
                        <label for="inputPassword" class="form-label">Mot de passe</label>
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg" type="submit">
                            Se connecter
                        </button>
                    </div>
                </form>

                {# Séparateur #}
                <div class="d-flex align-items-center my-4">
                    <hr class="flex-fill">
                    <span class="text-muted px-3 small fw-semibold">ou</span>
                    <hr class="flex-fill">
                </div>

                {# Bouton Google OAuth #}
                <div class="d-grid">
                    <a href="{{ path('connect_google_start') }}" class="btn btn-outline-dark btn-lg d-flex align-items-center justify-content-center gap-2 rounded-pill">
                        <svg width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        <span>Se connecter avec Google</span>
                    </a>
                </div>

                <div class="text-center mt-4">
                    <p class="text-muted">Pas encore de compte ? <a href="{{ path('app_register') }}" class="text-primary text-decoration-none fw-bold">S'inscrire</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
