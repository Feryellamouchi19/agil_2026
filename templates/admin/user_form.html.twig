{% extends 'base.html.twig' %}

{% block title %}{% if user is defined and user.id %}Modifier l'Utilisateur{% else %}Créer un Utilisateur{% endif %} - Admin AGIL{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-person-gear me-2"></i>
                    {% if user is defined and user.id %}
                        Modifier le compte de {{ user.prenom }} {{ user.nom }}
                    {% else %}
                        Nouveau Compte Utilisateur
                    {% endif %}
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="post" action="{% if user is defined and user.id %}{{ path('app_admin_user_edit', {id: user.id}) }}{% else %}{{ path('app_admin_user_new') }}{% endif %}" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="photo" class="form-label">Photo de profil</label>
                        <input type="file" id="photo" name="photo" class="form-control" accept="image/*">
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="nom" class="form-label">Nom *</label>
                            <input type="text" id="nom" name="nom" class="form-control" value="{{ user.nom ?? '' }}" required>
                        </div>
                        <div class="col-md-6">
                            <label for="prenom" class="form-label">Prénom *</label>
                            <input type="text" id="prenom" name="prenom" class="form-control" value="{{ user.prenom ?? '' }}" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Adresse Email *</label>
                        <input type="email" id="email" name="email" class="form-control" value="{{ user.email ?? '' }}" required>
                    </div>

                    <div class="mb-3">
                        <label for="telephone" class="form-label">Téléphone</label>
                        <input type="text" id="telephone" name="telephone" class="form-control" value="{{ user.telephone ?? '' }}">
                    </div>

                    <div class="mb-3">
                        <label for="role" class="form-label">Rôle *</label>
                        <select id="role" name="role" class="form-select" required>
                            {% set currentRole = (user is defined and user.roles|length > 0) ? user.roles[0] : 'ROLE_CLIENT' %}
                            <option value="ROLE_CLIENT" {% if currentRole == 'ROLE_CLIENT' %}selected{% endif %}>Client</option>
                            <option value="ROLE_AGILISTE" {% if currentRole == 'ROLE_AGILISTE' %}selected{% endif %}>Agiliste (Agent Guichet)</option>
                            <option value="ROLE_GERANT" {% if currentRole == 'ROLE_GERANT' %}selected{% endif %}>Gérant</option>
                            <option value="ROLE_ADMIN" {% if currentRole == 'ROLE_ADMIN' %}selected{% endif %}>Administrateur</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label">Mot de passe {% if user is defined and user.id %}<small class="text-muted">(laisser vide pour ne pas modifier)</small>{% else %}*{% endif %}</label>
                        <input type="password" id="password" name="password" class="form-control" {% if user is not defined or not user.id %}required{% endif %}>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{% if user is defined and user.id %}{{ path('app_admin_user_show', {id: user.id}) }}{% else %}{{ path('app_admin_users') }}{% endif %}" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            {% if user is defined and user.id %}Enregistrer les modifications{% else %}Créer le compte{% endif %}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
