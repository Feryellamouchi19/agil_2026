{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs - Admin AGIL{% endblock %}

{% block body %}
<div class="card shadow-sm border-0 rounded-3 mt-3">
    <div class="card-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold"><i class="bi bi-people me-2"></i>Gestion des Utilisateurs</h4>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-warning text-dark rounded-pill fw-bold">
            <i class="bi bi-person-plus-fill me-1"></i> Nouveau Compte
        </a>
    </div>

    {# Search & Filter Bar #}
    <div class="card-body border-bottom pb-3">
        <form method="get" action="{{ path('app_admin_users') }}" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-search me-1"></i>Recherche</label>
                <input type="text" name="q" value="{{ q }}" class="form-control form-control-sm shadow-none" placeholder="Nom, prénom, email, téléphone...">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-person-badge me-1"></i>Rôle</label>
                <select name="role" class="form-select form-select-sm shadow-none">
                    <option value="">Tous les rôles</option>
                    <option value="ROLE_CLIENT" {% if role == 'ROLE_CLIENT' %}selected{% endif %}>Client</option>
                    <option value="ROLE_AGILISTE" {% if role == 'ROLE_AGILISTE' %}selected{% endif %}>Agiliste</option>
                    <option value="ROLE_GERANT" {% if role == 'ROLE_GERANT' %}selected{% endif %}>Gérant</option>
                    <option value="ROLE_ADMIN" {% if role == 'ROLE_ADMIN' %}selected{% endif %}>Administrateur</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-toggle-on me-1"></i>Statut</label>
                <select name="statut" class="form-select form-select-sm shadow-none">
                    <option value="">Tous</option>
                    <option value="Actif" {% if statut == 'Actif' %}selected{% endif %}>Actif</option>
                    <option value="Inactif" {% if statut == 'Inactif' %}selected{% endif %}>Inactif</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 flex-fill">
                    <i class="bi bi-funnel-fill me-1"></i>Filtrer
                </button>
                {% if q or role or statut %}
                    <a href="{{ path('app_admin_users') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Réinitialiser">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </div>
        </form>
        {% if q or role or statut %}
        <div class="mt-2">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>
                {{ users|length }} résultat(s) trouvé(s)
                {% if q %} pour "<strong>{{ q }}</strong>"{% endif %}
            </small>
        </div>
        {% endif %}
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nom &amp; Prénom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                    <tr>
                        <td>
                            <a href="{{ path('app_admin_user_show', {id: u.id}) }}" class="text-decoration-none text-dark fw-bold hover-primary">
                                {{ u.prenom }} {{ u.nom }}
                            </a>
                            <small class="text-muted d-block">Inscrit le {{ u.dateCreation|date('d/m/Y') }}</small>
                        </td>
                        <td>
                            <a href="{{ path('app_admin_user_show', {id: u.id}) }}" class="text-decoration-none text-muted">
                                {{ u.email }}
                            </a>
                        </td>
                        <td>{{ u.telephone ?? '-' }}</td>
                        <td>
                            {% if 'ROLE_ADMIN' in u.roles %}
                                <span class="badge bg-danger">Administrateur</span>
                            {% elseif 'ROLE_GERANT' in u.roles %}
                                <span class="badge bg-success">Gérant</span>
                            {% elseif 'ROLE_AGILISTE' in u.roles %}
                                <span class="badge bg-primary">Agiliste</span>
                            {% else %}
                                <span class="badge bg-secondary">Client</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if u.statut == 'Actif' %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactif</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_user_show', {id: u.id}) }}" class="btn btn-sm btn-primary rounded-pill">
                                <i class="bi bi-person-lines-fill me-1"></i> Voir Profil
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-person-x display-6 d-block mb-2"></i>
                            Aucun utilisateur trouvé.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
